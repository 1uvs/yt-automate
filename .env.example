# ---- Twitch API (get from https://dev.twitch.tv/console/apps) ----
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---- YouTube ----
# Download an OAuth "Desktop app" client_secret JSON from Google Cloud Console
# (enable "YouTube Data API v3"), save it as client_secret.json in the project root.
# token.json is created automatically on first authorized run.

# ---- Optional: better viral titles/descriptions/hashtags + evolving strategy ----
# Priority order for metadata: OpenAI -> Gemini -> Anthropic -> built-in templates.
#
# OpenAI (GPT). Powers per-clip metadata (mini model) AND the daily strategy brain
# (smart model). Needs a key WITH active billing/credits — https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4              # smart model — used by the strategy brain (once/day)
OPENAI_MODEL_MINI=gpt-5.4-mini   # cheap/fast model — used for every clip's metadata
#
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash   # optional override (e.g. gemini-2.5-flash)
# Anthropic key: https://console.anthropic.com
ANTHROPIC_API_KEY=
